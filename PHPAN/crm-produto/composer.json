{
    "name": "asllan/crm-produto",
    "description": "CRM de produto — projeto do curso PHPAN",
    "type": "project",
    "require": {
        "php": "^8.3",
        "dompdf/dompdf": "^3.1",
        "vlucas/phpdotenv": "^5.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.64"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit tests",
        "analyse": "vendor/bin/phpstan analyse",
        "style:check": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "style:fix": "vendor/bin/php-cs-fixer fix",
        "quality": [
            "@style:check",
            "@analyse",
            "@test",
            "@security"
        ],
        "security": "composer audit"
    },
    "config": {
        "sort-packages": true
    }
}
